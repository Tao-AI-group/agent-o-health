@prefix core: <https://w3id.org/agent-o/core#> .
@prefix gov: <https://w3id.org/agent-o/gov#> .
@prefix health: <https://w3id.org/agent-o/health#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix report: <https://w3id.org/agent-o/reporting#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

report:ClinicalDecisionSupportGovernanceShape a sh:NodeShape ;
    sh:property [ sh:message "Clinical decision-support agents should declare an accountability role."@en ;
            sh:minCount 1 ;
            sh:path gov:hasAccountabilityRole ;
            sh:severity sh:Warning ],
        [ sh:message "Clinical decision-support agents should declare the allowed automation level."@en ;
            sh:minCount 1 ;
            sh:path gov:hasAutomationLevel ;
            sh:severity sh:Warning ],
        [ sh:message "Clinical decision-support agents should identify at least one governance risk."@en ;
            sh:minCount 1 ;
            sh:path gov:hasRisk ;
            sh:severity sh:Warning ],
        [ sh:message "Clinical decision-support agents should declare a post-deployment monitoring rule."@en ;
            sh:minCount 1 ;
            sh:path gov:monitoredBy ;
            sh:severity sh:Warning ] ;
    sh:sparql [ sh:message "Clinical decision-support systems should declare human review for their outputs, a system-level human-review requirement, or an override capability."@en ;
            sh:select """
      PREFIX core: <https://w3id.org/agent-o/core#>
      PREFIX gov: <https://w3id.org/agent-o/gov#>
      SELECT $this WHERE {
        FILTER NOT EXISTS {
          $this core:generates ?action .
          ?action gov:requiresReview ?review .
        }
        FILTER NOT EXISTS {
          $this gov:hasGovernanceRequirement ?review .
          ?review a gov:HumanReviewRequirement .
        }
        FILTER NOT EXISTS {
          ?policy gov:constrains $this ;
                  gov:hasOverrideCapability ?override .
        }
      }
    """ ] ;
    sh:severity sh:Warning ;
    sh:targetClass health:ClinicalDecisionSupportAgentSystem .

report:GovernanceProfileShape a sh:NodeShape ;
    sh:property [ sh:message "Governance profiles should identify multiple required governance-requirement types."@en ;
            sh:minCount 3 ;
            sh:path gov:requiresGovernanceRequirement ;
            sh:severity sh:Warning ],
        [ sh:message "Governance profiles should identify their external guideline references."@en ;
            sh:minCount 1 ;
            sh:path report:alignsWithGuideline ;
            sh:severity sh:Warning ] ;
    sh:targetClass report:GovernanceProfile .

report:HealthPHIGovernanceShape a sh:NodeShape ;
    sh:sparql [ sh:message "Health agents whose privacy constraint contains PHI should declare a compliance requirement."@en ;
            sh:select """
      PREFIX gov: <https://w3id.org/agent-o/gov#>
      SELECT $this WHERE {
        $this gov:hasPrivacyConstraint ?privacyConstraint .
        ?privacyConstraint gov:containsPHI true .
        FILTER NOT EXISTS {
          $this gov:requiresCompliance ?complianceRequirement .
        }
      }
    """ ] ;
    sh:severity sh:Warning ;
    sh:targetClass health:HealthAgentSystem .

report:HighRiskGovernanceShape a sh:NodeShape ;
    sh:sparql [ sh:message "High-risk agents should have a constraining policy with both fallback and escalation."@en ;
            sh:select """
      PREFIX gov: <https://w3id.org/agent-o/gov#>
      SELECT $this WHERE {
        $this gov:hasRisk ?risk .
        ?risk gov:hasSeverity ?severity .
        FILTER regex(lcase(str(?severity)), "^(high|critical)$")
        FILTER NOT EXISTS {
          ?policy gov:constrains $this ;
                  gov:hasFallbackStrategy ?fallbackStrategy ;
                  gov:hasEscalationPlan ?escalationPlan .
        }
      }
    """ ] ;
    sh:severity sh:Warning ;
    sh:targetClass core:Agent, core:AgentSystem .

report:PatientFacingGovernanceShape a sh:NodeShape ;
    sh:property [ sh:message "Patient-facing agents should declare intended users through their clinical use case."@en ;
            sh:minCount 1 ;
            sh:path ( health:hasIntendedClinicalUse health:hasIntendedUser ) ;
            sh:severity sh:Warning ] ;
    sh:sparql [ sh:message "Patient-facing agents should generate at least one patient-facing output with a declared output category."@en ;
            sh:select """
      PREFIX core: <https://w3id.org/agent-o/core#>
      PREFIX health: <https://w3id.org/agent-o/health#>
      SELECT $this WHERE {
        FILTER NOT EXISTS {
          $this core:generates ?output .
          ?output health:hasOutputCategory ?category .
        }
      }
    """ ] ;
    sh:severity sh:Warning ;
    sh:targetClass health:PatientFacingAgentSystem .

gov:EscalationPlanShape a sh:NodeShape ;
    sh:targetClass gov:EscalationPlan ;
    sh:not [ sh:class gov:EscalationEvent ] ;
    sh:property [ sh:path gov:hasTriggerCondition ;
            sh:class gov:TriggerCondition ],
        [ sh:path gov:plannedRecipient ;
            sh:class <https://w3id.org/agent-o/core#HumanAgent> ] ;
    sh:message "An escalation plan is a prospective control specification, not an escalation occurrence."@en .

gov:OverrideCapabilityShape a sh:NodeShape ;
    sh:targetClass gov:OverrideCapability ;
    sh:not [ sh:class gov:OverrideAction ] ;
    sh:property [ sh:path gov:canOverrideAction ;
            sh:class <https://w3id.org/agent-o/core#ProposedAction> ] ;
    sh:message "An override capability is a configured control, not an occurrence of exercising that control."@en .
