APP_HOST=0.0.0.0
APP_PORT=7860
APP_ENV=development
APP_COMMIT=uncommitted
APP_DATA_DIR=./var
APP_ACCESS_TOKEN=
ALLOW_INSECURE_BIND=false
SESSION_RETENTION_DAYS=90

AGENT_O_ROOT=/path/to/agent-o-health
AGIGEE_CREDENTIALS_PATH=/secure/path/to/credentials.jsonl

LLM_PROVIDER=mock
LLM_MODEL=
LLM_CREDENTIAL_ALIAS=key1
LLM_BASE_URL=
LLM_TOKEN_URL=
LLM_API_VERSION=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_COMPLETION_TOKENS=2000
LLM_REASONING_EFFORT=none

LOG_LEVEL=INFO
LOG_MESSAGE_CONTENT=false
RESEARCH_MODE=false
