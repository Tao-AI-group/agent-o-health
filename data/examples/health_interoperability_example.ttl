@prefix core: <https://w3id.org/agent-o/core#> .
@prefix doc: <https://w3id.org/agent-o/doc#> .
@prefix eval: <https://w3id.org/agent-o/eval#> .
@prefix ex: <https://w3id.org/agent-o/examples/health-interoperability#> .
@prefix gov: <https://w3id.org/agent-o/gov#> .
@prefix health: <https://w3id.org/agent-o/health#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:EHRDataUsePolicy a gov:Policy ;
    core:hasName "EHR data use policy" ;
    gov:constrainsDataUse ex:RestrictedEHRDataset .

ex:MedicationReviewEvaluation a eval:EvaluationStudy ;
    core:hasName "Medication review evaluation" ;
    eval:evaluates ex:EHRMedicationReviewAgent ;
    eval:usesDataset ex:RestrictedEHRDataset .

ex:AmbulatoryAdultPopulation a health:PatientPopulation ;
    core:hasName "Adults receiving ambulatory care" .

ex:AutonomousPrescribingContraindicated a health:ContraindicatedUse ;
    core:hasName "Autonomous medication prescribing or discontinuation" .

ex:AutonomousPrescribingOutOfScope a health:OutOfScopeUse ;
    core:hasName "Autonomous prescribing" .

ex:ClinicalPharmacySpecialty a health:ClinicalSpecialty ;
    core:hasName "Clinical pharmacy" .

ex:ClinicalResearchUsePermission a gov:DataUsePermission ;
    core:hasName "Clinical research use permission" .

ex:ClinicalReviewRequirement a gov:HumanReviewRequirement ;
    core:hasName "Medication safety clinical review requirement" .

ex:ClinicianFacingMode a health:DeploymentMode ;
    core:hasName "Clinician-facing support" .

ex:ConditionFHIRProfile a health:FHIRProfile ;
    core:hasName "Condition profile" .

ex:EHRMedicationReviewAgent a core:AgentSystem,
        health:ClinicalDecisionSupportAgentSystem ;
    core:generates ex:MedicationSafetyRecommendation ;
    core:hasComponent ex:MedicationReviewModelComponent ;
    core:hasInputType ex:EHRPatientRecordInput ;
    core:hasName "EHR medication review agent" ;
    core:hasSystemExecution ex:MedicationReviewRun ;
    core:usesModel ex:MedicationReviewModelComponent ;
    core:usesTool ex:FHIRExtractionTool ;
    gov:hasAccountabilityRole ex:MedicationReviewClinicalOwner ;
    gov:hasAutomationLevel ex:MedicationReviewSharedControl ;
    gov:hasPrivacyConstraint ex:PHIPrivacyConstraint ;
    gov:hasRisk ex:MedicationReviewPatientSafetyRisk ;
    gov:monitoredBy ex:MedicationReviewMonitoringRule ;
    gov:requiresCompliance ex:HIPAAComplianceRequirement ;
    health:hasClinicalSetting ex:AmbulatoryCareSetting ;
    health:hasInboundInterface ex:FHIRRESTInterface ;
    health:hasIntendedClinicalUse ex:MedicationReviewUseCase ;
    health:usesExchangeStandard ex:FHIRR4ExchangeStandard .

ex:FHIRExtractionTool a core:Tool ;
    core:hasName "FHIR extraction tool" ;
    core:hasVersion "R4-compatible demo interface" .

ex:FHIRR4ExchangeStandard a health:ExchangeStandard ;
    core:hasName "FHIR R4" .

ex:FHIRRESTInterface a health:InterfaceSpecification ;
    core:hasName "FHIR REST interface" .

ex:HIPAAComplianceRequirement a gov:ComplianceRequirement ;
    gov:complianceFramework "HIPAA" .

ex:InstitutionalDataUseCondition a gov:DataUseCondition ;
    core:hasName "Institutional data use condition" .

ex:MedicationDecisionSupportRole a health:ClinicalDecisionRole ;
    core:hasName "Medication decision support" .

ex:MedicationModelDeveloper a core:OrganizationAgent ;
    core:hasName "Example medication model developer" .

ex:MedicationModelIntendedUse a core:ModelIntendedUse ;
    core:hasDescription "Generate medication-risk findings for a supervised medication-review workflow." .

ex:MedicationModelLicense a doc:License ;
    core:hasName "Demonstration model license" .

ex:MedicationModelLimitation a core:ModelLimitation ;
    core:hasDescription "The model is not intended to prescribe, discontinue, or change medication autonomously." .

ex:MedicationModelProvider a core:OrganizationAgent ;
    core:hasName "Example medication model provider" .

ex:MedicationPlanReviewAction a health:IntendedClinicalAction ;
    core:hasName "Clinician review of the medication plan" .

ex:MedicationReasonerRole a core:ReasonerModelRole ;
    core:hasName "Medication reasoning role" .

ex:MedicationReconciliationStage a health:ClinicalWorkflowStage ;
    core:hasName "Medication reconciliation" .

ex:MedicationRelatedRiskCondition a health:TargetCondition ;
    core:hasName "Medication-related risk" .

ex:MedicationRequestFHIRProfile a health:FHIRProfile ;
    core:hasName "MedicationRequest profile" .

ex:MedicationReviewClinicalOwner a gov:AccountabilityRole ;
    core:hasName "Medication review clinical safety owner" .

ex:MedicationReviewModelDeployment a core:ModelDeployment ;
    core:deploymentAccessedAt "2026-08-19T11:00:00+00:00"^^xsd:dateTime ;
    core:deploymentVersion "deployment-2026-08" ;
    core:deploysModelResource ex:MedicationReviewModelSpecification ;
    core:hasProvider ex:MedicationModelProvider .

ex:MedicationReviewMonitoringRule a gov:MonitoringRule ;
    core:hasDescription "Monitor clinician overrides, alert burden, and subgroup performance for medication review recommendations." .

ex:MedicationReviewPatientSafetyRisk a gov:Risk ;
    core:hasName "Medication review patient safety risk" ;
    gov:hasMitigationStrategy "Require clinician review for medication safety recommendations derived from EHR inputs." ;
    gov:hasSeverity "moderate" .

ex:MedicationReviewRun a core:ExecutionRun ;
    core:generatedModelOutput ex:MedicationModelRiskOutput ;
    core:usesModelDeployment ex:MedicationReviewModelDeployment ;
    core:usesModelInputArtifact ex:ConditionInput,
        ex:EHRPatientRecordInput,
        ex:MedicationObservationInput .

ex:MedicationReviewSharedControl a gov:SharedControl ;
    core:hasName "Shared-control medication review operation" .

ex:MedicationReviewTrace a doc:LineageTrace ;
    doc:traceText "The recommendation was derived from FHIR Patient, MedicationRequest, and Condition inputs." .

ex:MedicationReviewUseCase a health:ClinicalUseCase ;
    core:hasName "Medication safety review" ;
    health:hasCareSetting ex:AmbulatoryCareSetting ;
    health:hasClinicalSpecialty ex:ClinicalPharmacySpecialty ;
    health:hasClinicalTask ex:MedicationSafetyReviewTask ;
    health:hasDecisionRole ex:MedicationDecisionSupportRole ;
    health:hasDeploymentMode ex:ClinicianFacingMode ;
    health:hasIntendedAction ex:MedicationPlanReviewAction ;
    health:hasIntendedUser ex:PharmacistIntendedUserRole ;
    health:hasOutOfScopeUse ex:AutonomousPrescribingOutOfScope ;
    health:hasProhibitedUse ex:AutonomousPrescribingContraindicated ;
    health:hasTargetCondition ex:MedicationRelatedRiskCondition ;
    health:hasTargetPopulation ex:AmbulatoryAdultPopulation ;
    health:hasWorkflowStage ex:MedicationReconciliationStage .

ex:MedicationRiskReasoningCapability a core:ModelCapability ;
    core:hasName "Medication risk reasoning" .

ex:MedicationRiskTextSpecification a core:ModelOutputSpecification ;
    core:hasDescription "Generated medication-risk text before creation of a clinical recommendation." .

ex:MedicationSafetyRecommendation a health:TreatmentRecommendation ;
    core:hasName "Medication safety recommendation" ;
    doc:derivedFrom ex:MedicationModelRiskOutput ;
    doc:hasLineageTrace ex:MedicationReviewTrace ;
    gov:requiresReview ex:ClinicalReviewRequirement ;
    health:derivedFromFHIRResource ex:ConditionInput,
        ex:EHRPatientRecordInput,
        ex:MedicationObservationInput .

ex:MedicationSafetyReviewTask a health:ClinicalTask ;
    core:hasName "Medication safety review" .

ex:PHIPrivacyConstraint a gov:PrivacyConstraint ;
    core:hasDescription "The EHR-derived inputs contain protected health information." ;
    gov:containsPHI true .

ex:PatientFHIRProfile a health:FHIRProfile ;
    core:hasName "Patient profile" .

ex:PharmacistIntendedUserRole a health:IntendedUserRole ;
    core:hasName "Pharmacist" .

ex:ProjectSpecificRestriction a gov:DataUseRestriction ;
    core:hasName "Project-specific data use restriction" .

ex:RxNormTerminology a health:TerminologySystem ;
    core:hasName "RxNorm" .

ex:StructuredDataModality a core:InputModality ;
    core:hasName "structured health data" .

ex:StructuredEHRModality a health:DataModality ;
    core:hasName "structured EHR data" .

ex:StructuredMedicationPromptSpecification a core:ModelInputSpecification ;
    core:hasDescription "Serialized text and JSON derived from FHIR resources." .

ex:AmbulatoryCareSetting a health:ClinicalSetting ;
    core:hasName "Ambulatory care setting" .

ex:ConditionInput a health:ConditionInput,
        health:StructuredHealthDataArtifact ;
    core:hasName "FHIR condition input" ;
    health:hasDataFormat ex:FHIRJSONFormat ;
    health:mapsToFHIRResource "http://hl7.org/fhir/Condition"^^xsd:anyURI ;
    health:usesFHIRProfile ex:ConditionFHIRProfile ;
    health:usesFHIRResourceType "Condition" ;
    health:usesTerminologySystem ex:SNOMEDCTTerminology .

ex:MedicationModelRiskOutput a core:GeneratedModelOutput ;
    core:hasDescription "Structured medication-risk findings generated before the agent creates a clinician-facing recommendation." ;
    core:hasName "Model-level medication risk output" .

ex:MedicationObservationInput a health:MedicationInput,
        health:StructuredHealthDataArtifact ;
    core:hasName "FHIR medication request input" ;
    health:hasDataFormat ex:FHIRJSONFormat ;
    health:mapsToFHIRResource "http://hl7.org/fhir/MedicationRequest"^^xsd:anyURI ;
    health:usesFHIRProfile ex:MedicationRequestFHIRProfile ;
    health:usesFHIRResourceType "MedicationRequest" ;
    health:usesTerminologySystem ex:RxNormTerminology .

ex:MedicationReviewModelComponent a core:ModelComponent ;
    core:hasModelComponentRole ex:MedicationReasonerRole ;
    core:hasName "Medication review reasoning component" ;
    core:usesModelResource ex:MedicationReviewModelSpecification .

ex:MedicationReviewModelSpecification a core:LanguageModel ;
    core:hasDeveloper ex:MedicationModelDeveloper ;
    core:hasModelCapability ex:MedicationRiskReasoningCapability ;
    core:hasModelInputSpecification ex:StructuredMedicationPromptSpecification ;
    core:hasModelIntendedUse ex:MedicationModelIntendedUse ;
    core:hasModelLimitation ex:MedicationModelLimitation ;
    core:hasModelOutputSpecification ex:MedicationRiskTextSpecification ;
    core:hasName "Medication review language model" ;
    core:modelArchitectureType "transformer language model" ;
    core:modelIdentifier "medication-review-demo" ;
    core:modelReleaseDate "2026-08-01"^^xsd:date ;
    core:modelVersion "snapshot-2026-08" ;
    core:supportsInputModality ex:StructuredDataModality ;
    doc:hasLicense ex:MedicationModelLicense .

ex:RestrictedEHRDataset a health:EHRDataSource ;
    core:hasName "Restricted EHR medication review dataset" ;
    eval:hasDataUseCondition ex:InstitutionalDataUseCondition ;
    eval:hasDataUsePermission ex:ClinicalResearchUsePermission ;
    eval:hasDataUseRestriction ex:ProjectSpecificRestriction ;
    health:hasDataModality ex:StructuredEHRModality .

ex:SNOMEDCTTerminology a health:TerminologySystem ;
    core:hasName "SNOMED CT" .

ex:EHRPatientRecordInput a health:FHIRResourceInput,
        health:PatientRecordInput,
        health:StructuredHealthDataArtifact ;
    core:hasName "FHIR patient record input" ;
    health:hasDataFormat ex:FHIRJSONFormat ;
    health:mapsToFHIRResource "http://hl7.org/fhir/Patient"^^xsd:anyURI ;
    health:usesFHIRProfile ex:PatientFHIRProfile ;
    health:usesFHIRResourceType "Patient" ;
    health:usesTerminologySystem ex:SNOMEDCTTerminology .

ex:FHIRJSONFormat a health:DataFormat ;
    core:hasName "FHIR JSON" .
