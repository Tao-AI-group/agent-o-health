PREFIX core: <https://w3id.org/agent-o/core#>
PREFIX doc: <https://w3id.org/agent-o/doc#>
PREFIX eval: <https://w3id.org/agent-o/eval#>
PREFIX prov: <http://www.w3.org/ns/prov#>

# Which source entities support a proposed action, which execution or tool
# activity generated each source, who was associated with that activity, and
# which evaluation result (if any) was derived from the same execution run?
SELECT DISTINCT ?action ?actionName ?sourceEntity ?activity ?associatedAgent ?metricResult
WHERE {
  ?action a core:ProposedAction ;
          doc:derivedFrom ?sourceEntity .
  OPTIONAL { ?action core:hasName ?actionName . }
  OPTIONAL {
    {
      ?sourceEntity prov:wasGeneratedBy ?activity .
    }
    UNION
    {
      ?activity core:generatedModelOutput ?sourceEntity .
    }
    OPTIONAL { ?activity prov:wasAssociatedWith ?associatedAgent . }
    OPTIONAL { ?metricResult eval:derivedFromRun ?activity . }
  }
}
ORDER BY ?action ?sourceEntity ?activity
