PREFIX core: <https://w3id.org/agent-o/core#>
PREFIX health: <https://w3id.org/agent-o/health#>

SELECT ?input ?inputName ?resourceType ?resourceIRI ?agent ?agentName ?recommendation
WHERE {
  ?input a health:FHIRResourceInput .
  OPTIONAL { ?input core:hasName ?inputName . }
  OPTIONAL { ?input health:usesFHIRResourceType ?resourceType . }
  OPTIONAL { ?input health:mapsToFHIRResource ?resourceIRI . }
  OPTIONAL {
    ?agent core:hasInputType ?input .
    OPTIONAL { ?agent core:hasName ?agentName . }
  }
  OPTIONAL {
    ?recommendation health:derivedFromFHIRResource ?input .
  }
}
ORDER BY ?input

