@prefix core: <https://w3id.org/agent-o/core#> .
@prefix doc: <https://w3id.org/agent-o/doc#> .
@prefix eval: <https://w3id.org/agent-o/eval#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report: <https://w3id.org/agent-o/reporting#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/agent-o/alignments/prov> a owl:Ontology ;
    rdfs:label "AGENT-O to PROV-O alignment"@en ;
    rdfs:comment "Safe provenance mappings from AGENT-O runtime, artifact, and lineage concepts to PROV-O. Agent-specific governance and reasoning concepts remain in AGENT-O."@en .

core:AIModelResource rdfs:subClassOf prov:Entity .

core:Agent rdfs:subClassOf prov:Agent .

core:AgentSystem rdfs:subClassOf prov:Entity .

core:Artifact rdfs:subClassOf prov:Entity .

core:ExecutionRun rdfs:subClassOf prov:Activity .

core:GeneratedModelOutput rdfs:subClassOf prov:Entity .

core:HumanAgent rdfs:subClassOf prov:Agent .

core:ModelDeployment rdfs:subClassOf prov:Entity .

core:Observation rdfs:subClassOf prov:Entity .

core:OrganizationAgent rdfs:subClassOf prov:Agent .

core:ProposedAction rdfs:subClassOf prov:Entity .

core:ToolInvocation rdfs:subClassOf prov:Activity .

core:WorkflowStep rdfs:subClassOf prov:Activity .

core:executedInRun skos:relatedMatch prov:wasInformedBy .

core:generatedModelOutput rdfs:subPropertyOf prov:generated .

core:hasDeveloper rdfs:subPropertyOf prov:wasAttributedTo .

core:hasProvider rdfs:subPropertyOf prov:wasAttributedTo .

core:performedBy skos:relatedMatch prov:wasAssociatedWith .

core:produces skos:relatedMatch prov:generated .

core:producesArtifact skos:relatedMatch prov:generated .

core:usesModelDeployment rdfs:subPropertyOf prov:used .

core:usesModelInputArtifact rdfs:subPropertyOf prov:used .

core:usesTool skos:relatedMatch prov:used .

doc:LineageTrace rdfs:subClassOf prov:Entity .

doc:derivedFrom rdfs:subPropertyOf prov:wasDerivedFrom .

eval:derivedFromRun skos:relatedMatch prov:wasGeneratedBy .

report:AgentSystemReport rdfs:subClassOf prov:Entity .

report:AssessmentAgent rdfs:subClassOf prov:Agent .

report:EvidenceStatement rdfs:subClassOf prov:Entity .

report:ModelCardReport rdfs:subClassOf prov:Entity .

report:ReportingAssessmentActivity rdfs:subClassOf prov:Activity .

report:ReportingCompletenessAssessment rdfs:subClassOf prov:Entity .

report:associatedWithAssessor rdfs:subPropertyOf prov:wasAssociatedWith .

report:generatedAssessment rdfs:subPropertyOf prov:generated .

report:generatedByAssessmentActivity rdfs:subPropertyOf prov:wasGeneratedBy .

report:usedReport rdfs:subPropertyOf prov:used .

report:usedReportingProfile rdfs:subPropertyOf prov:used .
