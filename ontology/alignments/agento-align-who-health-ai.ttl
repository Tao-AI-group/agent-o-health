@prefix gov: <https://w3id.org/agent-o/gov#> .
@prefix health: <https://w3id.org/agent-o/health#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/agent-o/alignments/who-health-ai> a owl:Ontology ;
    rdfs:label "AGENT-O WHO health AI governance profile alignment"@en ;
    rdfs:comment "WHO health AI ethics and governance guidance is represented as profile concepts and validation expectations rather than as direct OWL class equivalence."@en .

gov:AccountabilityRequirement skos:relatedMatch gov:WHOResponsibilityAccountability .

gov:EquityRequirement skos:relatedMatch gov:WHOInclusivenessEquity .

gov:ExplainabilityRequirement skos:relatedMatch gov:WHOTransparencyExplainability .

gov:HumanAutonomyRequirement skos:relatedMatch gov:WHOHumanAutonomy .

gov:PrivacyRequirement skos:relatedMatch gov:WHOSafetyPrivacy .

gov:SafetyRequirement skos:relatedMatch gov:WHOSafetyPrivacy .

gov:TransparencyRequirement skos:relatedMatch gov:WHOTransparencyExplainability .

health:ClinicalDecisionSupportAgent skos:relatedMatch gov:WHOResponsibilityAccountability,
        gov:WHOSafetyPrivacy .

health:PatientFacingAgent skos:relatedMatch gov:WHOHumanAutonomy,
        gov:WHOTransparencyExplainability .

gov:WHOInclusivenessEquity a skos:Concept ;
    rdfs:seeAlso <https://www.who.int/publications/i/item/9789240029200> ;
    skos:inScheme gov:WHOHealthAIConceptScheme ;
    skos:prefLabel "Ensure inclusiveness and equity"@en .

gov:WHOHumanAutonomy a skos:Concept ;
    rdfs:seeAlso <https://www.who.int/publications/i/item/9789240029200> ;
    skos:inScheme gov:WHOHealthAIConceptScheme ;
    skos:prefLabel "Protect human autonomy"@en .

gov:WHOResponsibilityAccountability a skos:Concept ;
    rdfs:seeAlso <https://www.who.int/publications/i/item/9789240029200> ;
    skos:inScheme gov:WHOHealthAIConceptScheme ;
    skos:prefLabel "Foster responsibility and accountability"@en .

gov:WHOSafetyPrivacy a skos:Concept ;
    rdfs:seeAlso <https://www.who.int/publications/i/item/9789240029200> ;
    skos:inScheme gov:WHOHealthAIConceptScheme ;
    skos:prefLabel "Promote safety, privacy, and public interest"@en .

gov:WHOTransparencyExplainability a skos:Concept ;
    rdfs:seeAlso <https://www.who.int/publications/i/item/9789240029200> ;
    skos:inScheme gov:WHOHealthAIConceptScheme ;
    skos:prefLabel "Ensure transparency, explainability, and intelligibility"@en .

gov:WHOHealthAIConceptScheme a skos:ConceptScheme ;
    rdfs:label "WHO Health AI Ethics and Governance Concept Scheme"@en ;
    skos:prefLabel "WHO Health AI Ethics and Governance Concept Scheme"@en .
