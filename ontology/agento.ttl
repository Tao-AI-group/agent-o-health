@prefix core: <https://w3id.org/agent-o/core#> .
@prefix doc: <https://w3id.org/agent-o/doc#> .
@prefix eval: <https://w3id.org/agent-o/eval#> .
@prefix gov: <https://w3id.org/agent-o/gov#> .
@prefix health: <https://w3id.org/agent-o/health#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report: <https://w3id.org/agent-o/reporting#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/agent-o> a owl:Ontology ;
    rdfs:label "AGENT-O Ontology"@en ;
    rdfs:comment "Integrated AGENT-O ontology covering agent systems, model specifications and deployments, runtime workflow, evaluation, documentation and provenance, governance, clinical context, health-data interoperability, and reporting-assessment representation."@en .

<https://w3id.org/agent-o/core> a owl:Ontology ;
    rdfs:label "AGENT-O Agent System, Model Components, and Runtime Ontology"@en ;
    rdfs:comment "Core layer for agent systems, component composition, versioned AI model specifications, model deployments, execution, tools, memory, planning, reasoning, resources, and environments."@en .

core:Approval a owl:Class ;
    rdfs:label "Approval"@en ;
    rdfs:subClassOf core:ReviewOutcome .

core:Communication a owl:Class ;
    rdfs:label "Communication"@en ;
    rdfs:subClassOf core:AgentInteraction .

core:Coordination a owl:Class ;
    rdfs:label "Coordination"@en ;
    rdfs:subClassOf core:AgentInteraction .

core:CriticModelRole a owl:Class ;
    rdfs:label "CriticModelRole"@en ;
    rdfs:subClassOf core:ModelComponentRole .

core:Delegation a owl:Class ;
    rdfs:label "Delegation"@en ;
    rdfs:subClassOf core:AgentInteraction .

core:EmbeddingModel a owl:Class ;
    rdfs:label "EmbeddingModel"@en ;
    rdfs:comment "An AI model specification for generating embedding representations."@en ;
    rdfs:subClassOf core:AIModelSpecification .

core:Environment a owl:Class ;
    rdfs:label "Environment"@en ;
    owl:equivalentClass core:ExecutionEnvironment .

core:FineTunedModel a owl:Class ;
    rdfs:label "FineTunedModel"@en ;
    rdfs:comment "An AI model specification derived by fine-tuning a base model specification."@en ;
    rdfs:subClassOf core:AIModelSpecification .

core:FoundationModel a owl:Class ;
    rdfs:label "FoundationModel"@en ;
    rdfs:comment "An AI model specification for a broadly pretrained foundation model."@en ;
    rdfs:subClassOf core:AIModelSpecification .

core:InvocationFailure a owl:Class ;
    rdfs:label "InvocationFailure"@en ;
    rdfs:subClassOf core:InvocationStatus .

core:InvocationSuccess a owl:Class ;
    rdfs:label "InvocationSuccess"@en ;
    rdfs:subClassOf core:InvocationStatus .

core:LanguageModel a owl:Class ;
    rdfs:label "LanguageModel"@en ;
    rdfs:comment "An AI model specification whose supported interfaces include language input or output."@en ;
    rdfs:subClassOf core:AIModelSpecification .

core:Memory a owl:Class ;
    rdfs:label "Memory"@en ;
    owl:equivalentClass core:MemoryModule .

core:Modification a owl:Class ;
    rdfs:label "Modification"@en ;
    rdfs:subClassOf core:ReviewOutcome .

core:MultimodalModel a owl:Class ;
    rdfs:label "MultimodalModel"@en ;
    rdfs:comment "An AI model specification supporting more than one input or output modality."@en ;
    rdfs:subClassOf core:AIModelSpecification .

core:OrganizationAgent a owl:Class ;
    rdfs:label "OrganizationAgent"@en ;
    rdfs:comment "An organization acting as a developer, provider, operator, owner, or assessor."@en ;
    rdfs:subClassOf core:Agent .

core:PlannerModelRole a owl:Class ;
    rdfs:label "PlannerModelRole"@en ;
    rdfs:subClassOf core:ModelComponentRole .

core:ReasonerModelRole a owl:Class ;
    rdfs:label "ReasonerModelRole"@en ;
    rdfs:subClassOf core:ModelComponentRole .

core:Rejection a owl:Class ;
    rdfs:label "Rejection"@en ;
    rdfs:subClassOf core:ReviewOutcome .

core:RetrieverModelRole a owl:Class ;
    rdfs:label "RetrieverModelRole"@en ;
    rdfs:subClassOf core:ModelComponentRole .

core:RouterModelRole a owl:Class ;
    rdfs:label "RouterModelRole"@en ;
    rdfs:subClassOf core:ModelComponentRole .

core:Script a owl:Class ;
    rdfs:label "Script"@en ;
    rdfs:subClassOf core:ExecutionUnit .

core:State a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:subClassOf core:Context .

core:StepCompleted a owl:Class ;
    rdfs:label "StepCompleted"@en ;
    rdfs:subClassOf core:ExecutionStatus .

core:StepFailed a owl:Class ;
    rdfs:label "StepFailed"@en ;
    rdfs:subClassOf core:ExecutionStatus .

core:StepPending a owl:Class ;
    rdfs:label "StepPending"@en ;
    rdfs:subClassOf core:ExecutionStatus .

core:StepRunning a owl:Class ;
    rdfs:label "StepRunning"@en ;
    rdfs:subClassOf core:ExecutionStatus .

core:VerifierModelRole a owl:Class ;
    rdfs:label "VerifierModelRole"@en ;
    rdfs:subClassOf core:ModelComponentRole .

core:VisionModel a owl:Class ;
    rdfs:label "VisionModel"@en ;
    rdfs:comment "An AI model specification whose supported interfaces include image or video data."@en ;
    rdfs:subClassOf core:AIModelSpecification .

core:assignedToAgent a owl:ObjectProperty ;
    rdfs:label "assignedToAgent"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:Agent .

core:causedByInvocation a owl:ObjectProperty ;
    rdfs:label "causedByInvocation"@en ;
    rdfs:domain core:FailureEvent ;
    rdfs:range core:ToolInvocation .

core:communicatesWith a owl:ObjectProperty ;
    rdfs:label "communicatesWith"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Agent .

core:consumesArtifact a owl:ObjectProperty ;
    rdfs:label "consumesArtifact"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:Artifact .

core:coordinatesWith a owl:ObjectProperty ;
    rdfs:label "coordinatesWith"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Agent .

core:delegatesTo a owl:ObjectProperty ;
    rdfs:label "delegatesTo"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Agent .

core:dependsOn a owl:ObjectProperty ;
    rdfs:label "dependsOn"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Context .

core:deploymentAccessedAt a owl:DatatypeProperty ;
    rdfs:label "deploymentAccessedAt"@en ;
    rdfs:comment "Records when a mutable or externally hosted model deployment was accessed."@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:dateTime .

core:deploymentEndpoint a owl:DatatypeProperty ;
    rdfs:label "deploymentEndpoint"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:anyURI .

core:deploymentRegion a owl:DatatypeProperty ;
    rdfs:label "deploymentRegion"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:string .

core:deploymentVersion a owl:DatatypeProperty ;
    rdfs:label "deploymentVersion"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:string .

core:deploysModelSpecification a owl:ObjectProperty ;
    rdfs:label "deploysModelSpecification"@en ;
    rdfs:comment "Links a concrete model deployment to the AI model specification it serves or loads."@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range core:AIModelSpecification .

core:endedAt a owl:DatatypeProperty ;
    rdfs:label "endedAt"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range xsd:dateTime .

core:errorMessage a owl:DatatypeProperty ;
    rdfs:label "errorMessage"@en ;
    rdfs:domain core:RuntimeError ;
    rdfs:range xsd:string .

core:executedInRun a owl:ObjectProperty ;
    rdfs:label "executedInRun"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:ExecutionRun .

core:failsWith a owl:ObjectProperty ;
    rdfs:label "failsWith"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range core:FailureEvent .

core:generatedModelOutput a owl:ObjectProperty ;
    rdfs:label "generatedModelOutput"@en ;
    rdfs:comment "Links an execution run to model-level output generated by using its model deployment."@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range core:GeneratedModelOutput .

core:generates a owl:ObjectProperty ;
    rdfs:label "generates"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:ProposedAction ;
    owl:equivalentProperty core:producesProposedAction .

core:generatesObservation a owl:ObjectProperty ;
    rdfs:label "generatesObservation"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Observation .

core:hasBaseModelSpecification a owl:ObjectProperty ;
    rdfs:label "hasBaseModelSpecification"@en ;
    rdfs:comment "Links a derived or fine-tuned model specification to its base model specification."@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:AIModelSpecification .

core:hasCapability a owl:ObjectProperty ;
    rdfs:label "hasCapability"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Skill .

core:hasComponent a owl:ObjectProperty ;
    rdfs:label "hasComponent"@en ;
    rdfs:comment "Links an agent system to a functional component in its architecture."@en ;
    rdfs:domain core:AgentSystem ;
    rdfs:range core:AgentComponent .

core:hasConfiguration a owl:ObjectProperty ;
    rdfs:label "hasConfiguration"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:AgentConfiguration .

core:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range core:Context .

core:hasDescription a owl:DatatypeProperty ;
    rdfs:label "hasDescription"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

core:hasDeveloper a owl:ObjectProperty ;
    rdfs:label "hasDeveloper"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:Agent .

core:hasExecutionRun a owl:ObjectProperty ;
    rdfs:label "hasExecutionRun"@en ;
    rdfs:domain core:Session ;
    rdfs:range core:ExecutionRun ;
    owl:inverseOf core:partOfSession .

core:hasExecutionStatus a owl:ObjectProperty ;
    rdfs:label "hasExecutionStatus"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:ExecutionStatus .

core:hasGoal a owl:ObjectProperty ;
    rdfs:label "hasGoal"@en ;
    rdfs:domain core:Task ;
    rdfs:range core:Goal .

core:hasInputType a owl:ObjectProperty ;
    rdfs:label "hasInputType"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:InputType .

core:hasInteraction a owl:ObjectProperty ;
    rdfs:label "hasInteraction"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:AgentInteraction .

core:hasInvocationInput a owl:ObjectProperty ;
    rdfs:label "hasInvocationInput"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:Artifact .

core:hasInvocationOutput a owl:ObjectProperty ;
    rdfs:label "hasInvocationOutput"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:Artifact .

core:hasInvocationStatus a owl:ObjectProperty ;
    rdfs:label "hasInvocationStatus"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:InvocationStatus .

core:hasModelCapability a owl:ObjectProperty ;
    rdfs:label "hasModelCapability"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:ModelCapability .

core:hasModelComponentRole a owl:ObjectProperty ;
    rdfs:label "hasModelComponentRole"@en ;
    rdfs:comment "Assigns a workflow function such as planning, reasoning, retrieval, criticism, verification, or routing to a model component."@en ;
    rdfs:domain core:ModelComponent ;
    rdfs:range core:ModelComponentRole .

core:hasModelInputSpecification a owl:ObjectProperty ;
    rdfs:label "hasModelInputSpecification"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:ModelInputSpecification .

core:hasModelIntendedUse a owl:ObjectProperty ;
    rdfs:label "hasModelIntendedUse"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:ModelIntendedUse .

core:hasModelLimitation a owl:ObjectProperty ;
    rdfs:label "hasModelLimitation"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:ModelLimitation .

core:hasModelOutputSpecification a owl:ObjectProperty ;
    rdfs:label "hasModelOutputSpecification"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:ModelOutputSpecification .

core:hasName a owl:DatatypeProperty ;
    rdfs:label "hasName"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

core:hasOutputType a owl:ObjectProperty ;
    rdfs:label "hasOutputType"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:OutputType .

core:hasProvider a owl:ObjectProperty ;
    rdfs:label "hasProvider"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range core:Agent .

core:hasReviewOutcome a owl:ObjectProperty ;
    rdfs:label "hasReviewOutcome"@en ;
    rdfs:domain core:ReviewEvent ;
    rdfs:range core:ReviewOutcome .

core:hasRole a owl:ObjectProperty ;
    rdfs:label "hasRole"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Role .

core:hasRuntimeError a owl:ObjectProperty ;
    rdfs:label "hasRuntimeError"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:RuntimeError .

core:hasStep a owl:ObjectProperty ;
    rdfs:label "hasStep"@en ;
    rdfs:domain core:Workflow ;
    rdfs:range core:WorkflowStep .

core:hasStepType a owl:ObjectProperty ;
    rdfs:label "hasStepType"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:StepType .

core:hasSystemExecution a owl:ObjectProperty ;
    rdfs:label "hasSystemExecution"@en ;
    rdfs:comment "Links an agent system to an execution run of that system."@en ;
    rdfs:domain core:AgentSystem ;
    rdfs:range core:ExecutionRun .

core:hasToolInvocation a owl:ObjectProperty ;
    rdfs:label "hasToolInvocation"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:ToolInvocation .

core:hasVersion a owl:DatatypeProperty ;
    rdfs:label "hasVersion"@en ;
    rdfs:comment "Records a version string for a software tool, execution unit, dataset, report, or other versioned entity; model resources use modelVersion for checkpoint-level identity."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

core:hasWorkflow a owl:ObjectProperty ;
    rdfs:label "hasWorkflow"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Workflow .

core:implementedBy a owl:ObjectProperty ;
    rdfs:label "implementedBy"@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:ExecutionUnit .

core:instantiatesPattern a owl:ObjectProperty ;
    rdfs:label "instantiatesPattern"@en ;
    rdfs:domain core:Workflow ;
    rdfs:range core:WorkflowPattern .

core:invokedBy a owl:ObjectProperty ;
    rdfs:label "invokedBy"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:Agent .

core:invokesAgent a owl:ObjectProperty ;
    rdfs:label "invokesAgent"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Agent .

core:invokesTool a owl:ObjectProperty ;
    rdfs:label "invokesTool"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:Tool .

core:modelArchitectureType a owl:DatatypeProperty ;
    rdfs:label "modelArchitectureType"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range xsd:string .

core:modelIdentifier a owl:DatatypeProperty ;
    rdfs:label "modelIdentifier"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range xsd:string .

core:modelReleaseDate a owl:DatatypeProperty ;
    rdfs:label "modelReleaseDate"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range xsd:date .

core:modelVersion a owl:DatatypeProperty ;
    rdfs:label "modelVersion"@en ;
    rdfs:comment "Records a model checkpoint, snapshot, release, or immutable version identifier."@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range xsd:string .

core:operatesIn a owl:ObjectProperty ;
    rdfs:label "operatesIn"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:ExecutionEnvironment ;
    owl:equivalentProperty core:hasExecutionEnvironment .

core:partOfStep a owl:ObjectProperty ;
    rdfs:label "partOfStep"@en ;
    rdfs:domain core:ToolInvocation ;
    rdfs:range core:WorkflowStep .

core:performedBy a owl:ObjectProperty ;
    rdfs:label "performedBy"@en ;
    rdfs:domain core:ReviewEvent ;
    rdfs:range core:HumanAgent .

core:performsTask a owl:ObjectProperty ;
    rdfs:label "performsTask"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Task .

core:precedesStep a owl:ObjectProperty ;
    rdfs:label "precedesStep"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:WorkflowStep .

core:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    rdfs:domain core:ExecutionUnit ;
    rdfs:range core:ProposedAction .

core:producesArtifact a owl:ObjectProperty ;
    rdfs:label "producesArtifact"@en ;
    rdfs:domain core:WorkflowStep ;
    rdfs:range core:Artifact .

core:quantization a owl:DatatypeProperty ;
    rdfs:label "quantization"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:string .

core:realizesModelSpecification a owl:ObjectProperty ;
    rdfs:label "realizesModelSpecification"@en ;
    rdfs:comment "Links a model component to the versioned AI model specification that realizes its function."@en ;
    rdfs:domain core:ModelComponent ;
    rdfs:range core:AIModelSpecification ;
    owl:inverseOf core:realizedByModelComponent .

core:realizesTask a owl:ObjectProperty ;
    rdfs:label "realizesTask"@en ;
    rdfs:domain core:Workflow ;
    rdfs:range core:Task .

core:requiresSkill a owl:ObjectProperty ;
    rdfs:label "requiresSkill"@en ;
    rdfs:domain core:Skill ;
    rdfs:range core:Skill .

core:resultsIn a owl:ObjectProperty ;
    rdfs:label "resultsIn"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range core:Outcome .

core:reviews a owl:ObjectProperty ;
    rdfs:label "reviews"@en ;
    rdfs:domain core:ReviewEvent ;
    rdfs:range core:ProposedAction ;
    owl:equivalentProperty core:reviewsAction .

core:runtimeConfiguration a owl:DatatypeProperty ;
    rdfs:label "runtimeConfiguration"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:string .

core:selects a owl:ObjectProperty ;
    rdfs:label "selects"@en ;
    rdfs:domain core:Planner ;
    rdfs:range core:Skill .

core:servingFramework a owl:DatatypeProperty ;
    rdfs:label "servingFramework"@en ;
    rdfs:domain core:ModelDeployment ;
    rdfs:range xsd:string .

core:startedAt a owl:DatatypeProperty ;
    rdfs:label "startedAt"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range xsd:dateTime .

core:statusCode a owl:DatatypeProperty ;
    rdfs:label "statusCode"@en ;
    rdfs:domain core:InvocationStatus ;
    rdfs:range xsd:string .

core:supportsInputModality a owl:ObjectProperty ;
    rdfs:label "supportsInputModality"@en ;
    rdfs:domain core:AIModelSpecification ;
    rdfs:range core:InputModality .

core:usesMemory a owl:ObjectProperty ;
    rdfs:label "usesMemory"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:MemoryModule ;
    rdfs:subPropertyOf core:uses ;
    owl:equivalentProperty core:hasMemoryModule .

core:usesModel a owl:ObjectProperty ;
    rdfs:label "usesModel"@en ;
    rdfs:comment "Links an agent to a model component it uses."@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:ModelComponent .

core:usesModelDeployment a owl:ObjectProperty ;
    rdfs:label "usesModelDeployment"@en ;
    rdfs:comment "Links an execution run to the concrete model deployment used at runtime."@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range core:ModelDeployment .

core:usesModelInputArtifact a owl:ObjectProperty ;
    rdfs:label "usesModelInputArtifact"@en ;
    rdfs:comment "Links an execution run to the runtime artifact supplied at a model interface, after any agent-level observation or data transformation."@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range core:Artifact .

core:usesPlanner a owl:ObjectProperty ;
    rdfs:label "usesPlanner"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Planner .

core:usesReasoner a owl:ObjectProperty ;
    rdfs:label "usesReasoner"@en ;
    rdfs:domain core:Agent ;
    rdfs:range core:Reasoner .

core:usesResource a owl:ObjectProperty ;
    rdfs:label "usesResource"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range core:Resource ;
    rdfs:subPropertyOf core:uses .

core:usesTool a owl:ObjectProperty ;
    rdfs:label "usesTool"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( core:Agent core:Skill ) ] ;
    rdfs:range core:Tool ;
    rdfs:subPropertyOf core:uses .

<https://w3id.org/agent-o/doc> a owl:Ontology ;
    rdfs:label "AGENT-O Documentation Ontology"@en ;
    rdfs:comment "Documentation/meta-data layer: citations, owners, licenses, versions, references, templates, provenance records, and lineage traces."@en .

doc:citationText a owl:DatatypeProperty ;
    rdfs:label "citationText"@en ;
    rdfs:domain doc:Citation ;
    rdfs:range xsd:string .

doc:contact a owl:DatatypeProperty ;
    rdfs:label "contact"@en ;
    rdfs:domain doc:Owner ;
    rdfs:range xsd:string .

doc:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derivedFrom"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Thing .

doc:hasAsset a owl:ObjectProperty ;
    rdfs:label "hasAsset"@en ;
    rdfs:domain core:Skill ;
    rdfs:range doc:Asset .

doc:hasCitation a owl:ObjectProperty ;
    rdfs:label "hasCitation"@en ;
    rdfs:domain core:Agent ;
    rdfs:range doc:Citation .

doc:hasLicense a owl:ObjectProperty ;
    rdfs:label "hasLicense"@en ;
    rdfs:domain core:Agent ;
    rdfs:range doc:License .

doc:hasLineageTrace a owl:ObjectProperty ;
    rdfs:label "hasLineageTrace"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range doc:LineageTrace .

doc:hasOwner a owl:ObjectProperty ;
    rdfs:label "hasOwner"@en ;
    rdfs:domain core:Agent ;
    rdfs:range doc:Owner .

doc:hasProvenanceRecord a owl:ObjectProperty ;
    rdfs:label "hasProvenanceRecord"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range doc:ProvenanceRecord .

doc:hasReference a owl:ObjectProperty ;
    rdfs:label "hasReference"@en ;
    rdfs:domain core:Agent ;
    rdfs:range doc:Reference .

doc:hasTemplate a owl:ObjectProperty ;
    rdfs:label "hasTemplate"@en ;
    rdfs:domain core:Skill ;
    rdfs:range doc:Template .

doc:hasVersionInfo a owl:ObjectProperty ;
    rdfs:label "hasVersionInfo"@en ;
    rdfs:domain core:Agent ;
    rdfs:range doc:VersionInfo .

doc:identifier a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:domain doc:License ;
    rdfs:range xsd:string .

doc:recordedAt a owl:DatatypeProperty ;
    rdfs:label "recordedAt"@en ;
    rdfs:domain doc:ProvenanceRecord ;
    rdfs:range xsd:dateTime .

doc:releaseDate a owl:DatatypeProperty ;
    rdfs:label "releaseDate"@en ;
    rdfs:domain doc:VersionInfo ;
    rdfs:range xsd:date .

doc:sourceURI a owl:DatatypeProperty ;
    rdfs:label "sourceURI"@en ;
    rdfs:comment "Records a source or access URI for a reference, report, provenance record, model card, or other documented resource."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:anyURI .

doc:versionString a owl:DatatypeProperty ;
    rdfs:label "versionString"@en ;
    rdfs:domain doc:VersionInfo ;
    rdfs:range xsd:string .

<https://w3id.org/agent-o/eval> a owl:Ontology ;
    rdfs:label "AGENT-O Evaluation Ontology"@en ;
    rdfs:comment "Evaluation layer: EvaluationStudy uses Dataset and produces MetricResult and Interpretation for an Agent."@en .

eval:BiasAssessment a owl:Class ;
    rdfs:label "BiasAssessment"@en ;
    rdfs:comment "An evaluation activity or result assessing bias in an agentic system."@en ;
    rdfs:subClassOf eval:EvaluationStudy .

eval:CostMetric a owl:Class ;
    rdfs:label "CostMetric"@en ;
    rdfs:comment "Metric that measures financial, compute, operational, or resource cost."@en ;
    rdfs:subClassOf eval:Metric .

eval:DatasetUseContext a owl:Class ;
    rdfs:label "DatasetUseContext"@en ;
    rdfs:comment "The use context under which a dataset is accessed, evaluated, or reused."@en .

eval:EvaluableEntity a owl:Class ;
    rdfs:label "EvaluableEntity"@en .

eval:FairnessMetric a owl:Class ;
    rdfs:label "FairnessMetric"@en ;
    rdfs:comment "A metric used to evaluate fairness properties of an agentic system."@en ;
    rdfs:subClassOf eval:EquityMetric .

eval:LatencyMetric a owl:Class ;
    rdfs:label "LatencyMetric"@en ;
    rdfs:comment "Metric that measures response time, execution time, or processing delay."@en ;
    rdfs:subClassOf eval:Metric .

eval:SafetyMetric a owl:Class ;
    rdfs:label "SafetyMetric"@en ;
    rdfs:comment "Metric that measures safety, harm avoidance, risk, or clinical appropriateness."@en ;
    rdfs:subClassOf eval:Metric .

eval:aboutEntity a owl:ObjectProperty ;
    rdfs:label "aboutEntity"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range owl:Thing .

eval:appliesToDataset a owl:ObjectProperty ;
    rdfs:label "appliesToDataset"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range eval:Dataset .

eval:appliesToSubpopulation a owl:ObjectProperty ;
    rdfs:label "appliesToSubpopulation"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range eval:Subpopulation .

eval:comparesAgainst a owl:ObjectProperty ;
    rdfs:label "comparesAgainst"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:Baseline .

eval:definesBenchmarkTask a owl:ObjectProperty ;
    rdfs:label "definesBenchmarkTask"@en ;
    rdfs:domain eval:BenchmarkFramework ;
    rdfs:range eval:BenchmarkTask .

eval:derivedFromRun a owl:ObjectProperty ;
    rdfs:label "derivedFromRun"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range core:ExecutionRun .

eval:evaluatedBy a owl:ObjectProperty ;
    rdfs:label "evaluatedBy"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:Evaluator .

eval:evaluates a owl:ObjectProperty ;
    rdfs:label "evaluates"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range core:Agent .

eval:evaluatesConfiguration a owl:ObjectProperty ;
    rdfs:label "evaluatesConfiguration"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range core:AgentConfiguration .

eval:forMetric a owl:ObjectProperty ;
    rdfs:label "forMetric"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range eval:Metric .

eval:hasDataUseCondition a owl:ObjectProperty ;
    rdfs:label "hasDataUseCondition"@en ;
    rdfs:comment "Links a dataset or dataset use context to a data use condition."@en ;
    rdfs:domain eval:Dataset ;
    rdfs:range gov:DataUseCondition .

eval:hasDataUsePermission a owl:ObjectProperty ;
    rdfs:label "hasDataUsePermission"@en ;
    rdfs:comment "Links a dataset or dataset use context to a data use permission."@en ;
    rdfs:domain eval:Dataset ;
    rdfs:range gov:DataUsePermission .

eval:hasDataUseRestriction a owl:ObjectProperty ;
    rdfs:label "hasDataUseRestriction"@en ;
    rdfs:comment "Links a dataset or dataset use context to a data use restriction."@en ;
    rdfs:domain eval:Dataset ;
    rdfs:range gov:DataUseRestriction .

eval:hasErrorType a owl:ObjectProperty ;
    rdfs:label "hasErrorType"@en ;
    rdfs:domain eval:FailureCase ;
    rdfs:range eval:ErrorType .

eval:hasRank a owl:DatatypeProperty ;
    rdfs:label "hasRank"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range xsd:integer .

eval:hasTimestamp a owl:DatatypeProperty ;
    rdfs:label "hasTimestamp"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range xsd:dateTime .

eval:hasUnit a owl:DatatypeProperty ;
    rdfs:label "hasUnit"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range xsd:string .

eval:hasValue a owl:DatatypeProperty ;
    rdfs:label "hasValue"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range xsd:decimal .

eval:interpretedAs a owl:ObjectProperty ;
    rdfs:label "interpretedAs"@en ;
    rdfs:domain eval:MetricResult ;
    rdfs:range eval:Interpretation .

eval:observedAtStep a owl:ObjectProperty ;
    rdfs:label "observedAtStep"@en ;
    rdfs:domain eval:FailureCase ;
    rdfs:range core:WorkflowStep .

eval:observedInRun a owl:ObjectProperty ;
    rdfs:label "observedInRun"@en ;
    rdfs:domain eval:FailureCase ;
    rdfs:range core:ExecutionRun .

eval:producesResult a owl:ObjectProperty ;
    rdfs:label "producesResult"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:MetricResult .

eval:studiesAutomationLevel a owl:ObjectProperty ;
    rdfs:label "studiesAutomationLevel"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range gov:AutomationLevel .

eval:targetsTask a owl:ObjectProperty ;
    rdfs:label "targetsTask"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:BenchmarkTask .

eval:usesDataset a owl:ObjectProperty ;
    rdfs:label "usesDataset"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:Dataset .

eval:usesEvaluationFramework a owl:ObjectProperty ;
    rdfs:label "usesEvaluationFramework"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:EvaluationFramework .

eval:usesScenario a owl:ObjectProperty ;
    rdfs:label "usesScenario"@en ;
    rdfs:domain eval:EvaluationStudy ;
    rdfs:range eval:Scenario .

<https://w3id.org/agent-o/gov> a owl:Ontology ;
    rdfs:label "AGENT-O Governance Ontology"@en ;
    rdfs:comment "Governance layer: risk, uncertainty, limitations, policies, automation levels, escalation, human review, security, privacy, compliance, and overrides."@en .

gov:AccountabilityRequirement a owl:Class ;
    rdfs:label "AccountabilityRequirement"@en ;
    rdfs:comment "A requirement assigning responsibility and accountability for agentic system behavior."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:Augmentation a owl:Class ;
    rdfs:label "Augmentation"@en ;
    rdfs:subClassOf gov:AutomationLevel .

gov:ConsentConstraint a owl:Class ;
    rdfs:label "ConsentConstraint"@en ;
    rdfs:comment "A data use condition derived from consent, authorization, or participant preference."@en ;
    rdfs:subClassOf gov:DataUseRestriction .

gov:Delegation a owl:Class ;
    rdfs:label "Delegation"@en ;
    rdfs:subClassOf gov:AutomationLevel .

gov:EquityRequirement a owl:Class ;
    rdfs:label "EquityRequirement"@en ;
    rdfs:comment "A requirement addressing fairness, inclusion, accessibility, or equity in agentic health AI."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:ExplainabilityRequirement a owl:Class ;
    rdfs:label "ExplainabilityRequirement"@en ;
    rdfs:comment "A requirement that an agentic system provide understandable explanations or decision support rationale."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:FullAutomation a owl:Class ;
    rdfs:label "FullAutomation"@en ;
    rdfs:subClassOf gov:AutomationLevel .

gov:HumanAutonomyRequirement a owl:Class ;
    rdfs:label "HumanAutonomyRequirement"@en ;
    rdfs:comment "A requirement preserving human agency, autonomy, or meaningful human control."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:PrivacyRequirement a owl:Class ;
    rdfs:label "PrivacyRequirement"@en ;
    rdfs:comment "A requirement addressing privacy, confidentiality, data protection, or sensitive-data handling."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:SafetyRequirement a owl:Class ;
    rdfs:label "SafetyRequirement"@en ;
    rdfs:comment "A requirement addressing safety, harm prevention, or clinical risk mitigation."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:SharedControl a owl:Class ;
    rdfs:label "SharedControl"@en ;
    rdfs:subClassOf gov:AutomationLevel .

gov:Threshold a owl:Class ;
    rdfs:label "Threshold"@en .

gov:TransparencyRequirement a owl:Class ;
    rdfs:label "TransparencyRequirement"@en ;
    rdfs:comment "A requirement for transparency about an agentic system, its purpose, limitations, or outputs."@en ;
    rdfs:subClassOf gov:EthicalPrinciple .

gov:accessControlRequirement a owl:DatatypeProperty ;
    rdfs:label "accessControlRequirement"@en ;
    rdfs:domain gov:SecurityConstraint ;
    rdfs:range xsd:string .

gov:complianceFramework a owl:DatatypeProperty ;
    rdfs:label "complianceFramework"@en ;
    rdfs:domain gov:ComplianceRequirement ;
    rdfs:range xsd:string .

gov:conditionExpression a owl:DatatypeProperty ;
    rdfs:label "conditionExpression"@en ;
    rdfs:domain gov:TriggerCondition ;
    rdfs:range xsd:string .

gov:confidenceValue a owl:DatatypeProperty ;
    rdfs:label "confidenceValue"@en ;
    rdfs:domain gov:ConfidenceScore ;
    rdfs:range xsd:decimal .

gov:constrains a owl:ObjectProperty ;
    rdfs:label "constrains"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range core:Agent ;
    owl:inverseOf gov:constrainedBy .

gov:constrainsDataUse a owl:ObjectProperty ;
    rdfs:label "constrainsDataUse"@en ;
    rdfs:comment "Links a governance policy or data use condition to the dataset whose use it constrains."@en ;
    rdfs:domain gov:Policy ;
    rdfs:range eval:Dataset .

gov:containsPHI a owl:DatatypeProperty ;
    rdfs:label "containsPHI"@en ;
    rdfs:domain gov:PrivacyConstraint ;
    rdfs:range xsd:boolean .

gov:definesAutomationLevel a owl:ObjectProperty ;
    rdfs:label "definesAutomationLevel"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range gov:AutomationLevel .

gov:enablesOverride a owl:ObjectProperty ;
    rdfs:label "enablesOverride"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range gov:OverrideAction .

gov:escalatesTo a owl:ObjectProperty ;
    rdfs:label "escalatesTo"@en ;
    rdfs:domain gov:EscalationEvent ;
    rdfs:range core:HumanAgent .

gov:hasAccountabilityRole a owl:ObjectProperty ;
    rdfs:label "hasAccountabilityRole"@en ;
    rdfs:comment "Links an agent, report, policy, or evaluation to an accountability role."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:AccountabilityRole .

gov:hasAutomationLevel a owl:ObjectProperty ;
    rdfs:label "hasAutomationLevel"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:AutomationLevel .

gov:hasConfidenceScore a owl:ObjectProperty ;
    rdfs:label "hasConfidenceScore"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:ConfidenceScore .

gov:hasCriterion a owl:ObjectProperty ;
    rdfs:label "hasCriterion"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range gov:DecisionCriterion .

gov:hasDeploymentStatus a owl:ObjectProperty ;
    rdfs:label "hasDeploymentStatus"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:DeploymentStatus .

gov:hasEthicalConcern a owl:ObjectProperty ;
    rdfs:label "hasEthicalConcern"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:EthicalConcern .

gov:hasEthicalPrinciple a owl:ObjectProperty ;
    rdfs:label "hasEthicalPrinciple"@en ;
    rdfs:comment "Links an agent, report, policy, or governance profile to an ethical principle or governance requirement."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:EthicalPrinciple .

gov:hasFallbackStrategy a owl:ObjectProperty ;
    rdfs:label "hasFallbackStrategy"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range gov:FallbackStrategy .

gov:hasLimitation a owl:ObjectProperty ;
    rdfs:label "hasLimitation"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:Limitation .

gov:hasMitigationStrategy a owl:DatatypeProperty ;
    rdfs:label "hasMitigationStrategy"@en ;
    rdfs:domain gov:Risk ;
    rdfs:range xsd:string .

gov:hasPrivacyConstraint a owl:ObjectProperty ;
    rdfs:label "hasPrivacyConstraint"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:PrivacyConstraint .

gov:hasRegulatoryStatus a owl:ObjectProperty ;
    rdfs:label "hasRegulatoryStatus"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:RegulatoryStatus .

gov:hasRisk a owl:ObjectProperty ;
    rdfs:label "hasRisk"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:Risk .

gov:hasSecurityConstraint a owl:ObjectProperty ;
    rdfs:label "hasSecurityConstraint"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:SecurityConstraint .

gov:hasSeverity a owl:DatatypeProperty ;
    rdfs:label "hasSeverity"@en ;
    rdfs:domain gov:Risk ;
    rdfs:range xsd:string .

gov:hasUncertainty a owl:ObjectProperty ;
    rdfs:label "hasUncertainty"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:Uncertainty .

gov:influencesMetric a owl:ObjectProperty ;
    rdfs:label "influencesMetric"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range eval:Metric .

gov:mitigatesRisk a owl:ObjectProperty ;
    rdfs:label "mitigatesRisk"@en ;
    rdfs:comment "Links a policy, fallback strategy, monitoring rule, or requirement to a risk it mitigates."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:Risk .

gov:monitoredBy a owl:ObjectProperty ;
    rdfs:label "monitoredBy"@en ;
    rdfs:domain core:Agent ;
    rdfs:range gov:MonitoringRule .

gov:overridesAction a owl:ObjectProperty ;
    rdfs:label "overridesAction"@en ;
    rdfs:domain gov:OverrideAction ;
    rdfs:range core:ProposedAction .

gov:policyVariantUsedIn a owl:ObjectProperty ;
    rdfs:label "policyVariantUsedIn"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range eval:EvaluationStudy .

gov:recordedAs a owl:ObjectProperty ;
    rdfs:label "recordedAs"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range gov:AuditEvent .

gov:requiredForPattern a owl:ObjectProperty ;
    rdfs:label "requiredForPattern"@en ;
    rdfs:domain gov:HumanReviewRequirement ;
    rdfs:range core:WorkflowPattern .

gov:requiresCompliance a owl:ObjectProperty ;
    rdfs:label "requiresCompliance"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range gov:ComplianceRequirement .

gov:requiresReview a owl:ObjectProperty ;
    rdfs:label "requiresReview"@en ;
    rdfs:domain core:ProposedAction ;
    rdfs:range gov:HumanReviewRequirement .

gov:satisfiedByReviewEvent a owl:ObjectProperty ;
    rdfs:label "satisfiedByReviewEvent"@en ;
    rdfs:domain gov:HumanReviewRequirement ;
    rdfs:range core:ReviewEvent .

gov:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggeredBy"@en ;
    rdfs:domain gov:EscalationEvent ;
    rdfs:range gov:TriggerCondition ;
    owl:equivalentProperty gov:hasTriggerCondition .

gov:triggersEscalation a owl:ObjectProperty ;
    rdfs:label "triggersEscalation"@en ;
    rdfs:domain gov:Policy ;
    rdfs:range gov:EscalationEvent .

gov:triggersIncident a owl:ObjectProperty ;
    rdfs:label "triggersIncident"@en ;
    rdfs:domain core:ExecutionRun ;
    rdfs:range gov:Incident .

gov:uncertaintyValue a owl:DatatypeProperty ;
    rdfs:label "uncertaintyValue"@en ;
    rdfs:domain gov:Uncertainty ;
    rdfs:range xsd:decimal .

<https://w3id.org/agent-o/health> a owl:Ontology ;
    rdfs:label "AGENT-O Clinical Context, Intended Use, and Health Data Interoperability Ontology"@en ;
    rdfs:comment "Health extension with separate sublayers for clinical context and intended use, health-data representation, and interoperability specifications."@en .

health:BiomedicalAgent a owl:Class ;
    rdfs:label "BiomedicalAgent"@en ;
    rdfs:comment "An agent used for biomedical research or analysis."@en ;
    rdfs:subClassOf health:HealthAgent .

health:CareTeamRole a owl:Class ;
    rdfs:label "CareTeamRole"@en ;
    rdfs:comment "A care team role associated with a health agent or review process."@en ;
    rdfs:subClassOf core:Role .

health:ClinicalDecisionSupportAgent a owl:Class ;
    rdfs:label "ClinicalDecisionSupportAgent"@en ;
    rdfs:comment "A clinical agent that supports clinical decisions."@en ;
    rdfs:subClassOf health:ClinicalAgent .

health:ClinicalGuidelineSource a owl:Class ;
    rdfs:label "ClinicalGuidelineSource"@en ;
    rdfs:comment "A clinical guideline source used by an agent."@en ;
    rdfs:subClassOf doc:Reference .

health:ClinicianFacingAgent a owl:Class ;
    rdfs:label "ClinicianFacingAgent"@en ;
    rdfs:comment "A health agent whose outputs are intended for clinicians or care teams."@en ;
    rdfs:subClassOf health:HealthAgent .

health:ClinicianFacingOutput a owl:Class ;
    rdfs:label "ClinicianFacingOutput"@en ;
    rdfs:comment "An agent output intended for clinicians or care teams."@en ;
    rdfs:subClassOf core:Artifact .

health:ConditionInput a owl:Class ;
    rdfs:label "ConditionInput"@en ;
    rdfs:comment "An input artifact mapped to a FHIR Condition resource."@en ;
    rdfs:subClassOf health:FHIRResourceInput .

health:ContraindicatedUse a owl:Class ;
    rdfs:label "ContraindicatedUse"@en ;
    rdfs:comment "A use that is clinically contraindicated for an agent system."@en ;
    rdfs:subClassOf health:ProhibitedUse .

health:DiagnosticRecommendation a owl:Class ;
    rdfs:label "DiagnosticRecommendation"@en ;
    rdfs:comment "A diagnostic recommendation produced by an agent."@en ;
    rdfs:subClassOf health:ClinicalRecommendation .

health:DiagnosticReportInput a owl:Class ;
    rdfs:label "DiagnosticReportInput"@en ;
    rdfs:comment "An input artifact mapped to a FHIR DiagnosticReport resource."@en ;
    rdfs:subClassOf health:FHIRResourceInput .

health:EHRDataSource a owl:Class ;
    rdfs:label "EHRDataSource"@en ;
    rdfs:comment "An electronic health record data source."@en ;
    rdfs:subClassOf health:HealthDataSource .

health:MedicationInput a owl:Class ;
    rdfs:label "MedicationInput"@en ;
    rdfs:comment "An input artifact mapped to a FHIR Medication or MedicationRequest resource."@en ;
    rdfs:subClassOf health:FHIRResourceInput .

health:ObservationInput a owl:Class ;
    rdfs:label "ObservationInput"@en ;
    rdfs:comment "An input artifact mapped to a FHIR Observation resource."@en ;
    rdfs:subClassOf health:FHIRResourceInput .

health:PHIDataSource a owl:Class ;
    rdfs:label "PHIDataSource"@en ;
    rdfs:comment "A health data source containing protected health information."@en ;
    rdfs:subClassOf health:HealthDataSource .

health:PatientFacingAgent a owl:Class ;
    rdfs:label "PatientFacingAgent"@en ;
    rdfs:comment "A health agent whose outputs are intended for patients or caregivers."@en ;
    rdfs:subClassOf health:HealthAgent .

health:PatientRecordInput a owl:Class ;
    rdfs:label "PatientRecordInput"@en ;
    rdfs:comment "An input artifact representing patient record information."@en ;
    rdfs:subClassOf health:EHRInput .

health:ProcedureInput a owl:Class ;
    rdfs:label "ProcedureInput"@en ;
    rdfs:comment "An input artifact mapped to a FHIR Procedure resource."@en ;
    rdfs:subClassOf health:FHIRResourceInput .

health:TreatmentRecommendation a owl:Class ;
    rdfs:label "TreatmentRecommendation"@en ;
    rdfs:comment "A treatment recommendation produced by an agent."@en ;
    rdfs:subClassOf health:ClinicalRecommendation .

health:UnstructuredHealthDataArtifact a owl:Class ;
    rdfs:label "UnstructuredHealthDataArtifact"@en ;
    rdfs:comment "An agent-level artifact containing unstructured health data such as narrative text, images, waveforms, audio, or video."@en ;
    rdfs:subClassOf core:Artifact ;
    owl:disjointWith health:StructuredHealthDataArtifact .

health:derivedFromFHIRResource a owl:ObjectProperty ;
    rdfs:label "derivedFromFHIRResource"@en ;
    rdfs:comment "Links an AGENT-O artifact to a FHIR-derived input artifact from which it was derived."@en ;
    rdfs:domain core:Artifact ;
    rdfs:range health:FHIRResourceInput .

health:hasCareSetting a owl:ObjectProperty ;
    rdfs:label "hasCareSetting"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:ClinicalSetting .

health:hasClinicalSetting a owl:ObjectProperty ;
    rdfs:label "hasClinicalSetting"@en ;
    rdfs:comment "Links a health agent, task, or evaluation to a clinical setting."@en ;
    rdfs:domain core:Agent ;
    rdfs:range health:ClinicalSetting .

health:hasClinicalSpecialty a owl:ObjectProperty ;
    rdfs:label "hasClinicalSpecialty"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:ClinicalSpecialty .

health:hasClinicalTask a owl:ObjectProperty ;
    rdfs:label "hasClinicalTask"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:ClinicalTask .

health:hasDataFormat a owl:ObjectProperty ;
    rdfs:label "hasDataFormat"@en ;
    rdfs:domain core:Artifact ;
    rdfs:range health:DataFormat .

health:hasDataModality a owl:ObjectProperty ;
    rdfs:label "hasDataModality"@en ;
    rdfs:domain health:HealthDataSource ;
    rdfs:range health:DataModality .

health:hasDecisionRole a owl:ObjectProperty ;
    rdfs:label "hasDecisionRole"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:ClinicalDecisionRole .

health:hasDeploymentMode a owl:ObjectProperty ;
    rdfs:label "hasDeploymentMode"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:DeploymentMode .

health:hasInboundInterface a owl:ObjectProperty ;
    rdfs:label "hasInboundInterface"@en ;
    rdfs:domain core:AgentSystem ;
    rdfs:range health:InterfaceSpecification .

health:hasIntendedAction a owl:ObjectProperty ;
    rdfs:label "hasIntendedAction"@en ;
    rdfs:comment "Links a clinical use case to the clinical action that the agent system is intended to inform, recommend, initiate, or support."@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:IntendedClinicalAction .

health:hasOutOfScopeUse a owl:ObjectProperty ;
    rdfs:label "hasOutOfScopeUse"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:OutOfScopeUse .

health:hasOutboundInterface a owl:ObjectProperty ;
    rdfs:label "hasOutboundInterface"@en ;
    rdfs:domain core:AgentSystem ;
    rdfs:range health:InterfaceSpecification .

health:hasOutputCategory a owl:DatatypeProperty ;
    rdfs:label "hasOutputCategory"@en ;
    rdfs:comment "Records whether a patient-facing output is advice, education, recommendation, triage, or another communication category."@en ;
    rdfs:domain health:PatientFacingOutput ;
    rdfs:range xsd:string .

health:hasProhibitedUse a owl:ObjectProperty ;
    rdfs:label "hasProhibitedUse"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:ProhibitedUse .

health:hasTargetCondition a owl:ObjectProperty ;
    rdfs:label "hasTargetCondition"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:TargetCondition .

health:hasTargetPopulation a owl:ObjectProperty ;
    rdfs:label "hasTargetPopulation"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:PatientPopulation .

health:hasWorkflowStage a owl:ObjectProperty ;
    rdfs:label "hasWorkflowStage"@en ;
    rdfs:domain health:ClinicalUseCase ;
    rdfs:range health:ClinicalWorkflowStage .

health:mapsToFHIRResource a owl:DatatypeProperty ;
    rdfs:label "mapsToFHIRResource"@en ;
    rdfs:comment "Records the canonical FHIR RDF class or resource IRI that an AGENT-O artifact maps to."@en ;
    rdfs:domain core:Artifact ;
    rdfs:range xsd:anyURI .

health:transformedBy a owl:ObjectProperty ;
    rdfs:label "transformedBy"@en ;
    rdfs:comment "Links a health-data artifact to a transformation that produces an agent- or model-level representation."@en ;
    rdfs:domain core:Artifact ;
    rdfs:range health:DataTransformation .

health:usesExchangeStandard a owl:ObjectProperty ;
    rdfs:label "usesExchangeStandard"@en ;
    rdfs:domain core:AgentSystem ;
    rdfs:range health:ExchangeStandard .

health:usesFHIRProfile a owl:ObjectProperty ;
    rdfs:label "usesFHIRProfile"@en ;
    rdfs:domain health:FHIRResourceInput ;
    rdfs:range health:FHIRProfile .

health:usesFHIRResourceType a owl:DatatypeProperty ;
    rdfs:label "usesFHIRResourceType"@en ;
    rdfs:comment "Records the FHIR resource type used by an input, output, dataset, or workflow step."@en ;
    rdfs:domain core:Artifact ;
    rdfs:range xsd:string .

health:usesTerminologySystem a owl:ObjectProperty ;
    rdfs:label "usesTerminologySystem"@en ;
    rdfs:domain core:Artifact ;
    rdfs:range health:TerminologySystem .

