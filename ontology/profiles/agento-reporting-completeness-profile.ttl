@prefix core: <https://w3id.org/agent-o/core#> .
@prefix doc: <https://w3id.org/agent-o/doc#> .
@prefix exprof: <https://w3id.org/agent-o/profiles#> .
@prefix health: <https://w3id.org/agent-o/health#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report: <https://w3id.org/agent-o/reporting#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

exprof:ReportingCompletenessProfile a report:ReportingCompletenessProfile ;
    rdfs:label "AGENT-O reporting completeness profile"@en ;
    report:alignsWithGuideline exprof:ReportingCompletenessRubricReference ;
    report:hasRequirement exprof:AssessmentProvenanceRequirement,
        exprof:ClinicalUseContextRequirement,
        exprof:ModelDeploymentRequirement,
        exprof:ModelIdentityRequirement,
        exprof:ModelRoleRequirement ;
    report:recommendedReportingSection report:AssessmentMethodsSection,
        report:ClinicalContextSection,
        report:DataUseSection,
        report:DeploymentMonitoringSection,
        report:FailureFallbackSection,
        report:ModelComponentsSection,
        report:SubgroupEquityEvaluationSection ;
    report:requiresReportingSection report:AgentIdentityScopeSection,
        report:EvaluationReportingSection,
        report:GovernanceReportingSection,
        report:HumanReviewSection,
        report:IntendedUseSection,
        report:ModelSpecificationSection,
        report:ReproducibilitySection,
        report:RuntimeArchitectureSection .

<https://w3id.org/agent-o/profiles/reporting-completeness> a owl:Ontology ;
    rdfs:label "AGENT-O Reporting Completeness Profile"@en ;
    rdfs:comment "Application profile used by an external assessment pipeline to evaluate whether papers and reports provide enough evidence for AGENT-O representation."@en .

exprof:AssessmentProvenanceRequirement a report:ReportingRequirement ;
    rdfs:label "Assessment provenance requirement"@en ;
    report:requirementTargetsSection report:AssessmentMethodsSection ;
    report:requiresInformationElement report:ReportingAssessmentActivity,
        report:associatedWithAssessor,
        report:generatedAssessment,
        report:hasHumanVerificationStatus,
        report:hasSupportingEvidence,
        report:usedReport,
        report:usedReportingProfile .

exprof:ClinicalUseContextRequirement a report:ReportingRequirement ;
    rdfs:label "Clinical use context requirement"@en ;
    report:requirementTargetsSection report:IntendedUseSection ;
    report:requiresInformationElement health:ClinicalUseCase,
        health:hasCareSetting,
        health:hasClinicalSpecialty,
        health:hasClinicalTask,
        health:hasDecisionRole,
        health:hasDeploymentMode,
        health:hasIntendedAction,
        health:hasIntendedUser,
        health:hasOutOfScopeUse,
        health:hasProhibitedUse,
        health:hasTargetCondition,
        health:hasTargetPopulation,
        health:hasWorkflowStage .

exprof:ModelDeploymentRequirement a report:ReportingRequirement ;
    rdfs:label "Model deployment provenance requirement"@en ;
    report:requirementTargetsSection report:ModelSpecificationSection ;
    report:requiresInformationElement core:ModelDeployment,
        core:deploymentAccessedAt,
        core:deploymentEndpoint,
        core:deploymentRegion,
        core:deploymentVersion,
        core:deploysModelResource,
        core:hasProvider,
        core:quantization,
        core:runtimeConfiguration,
        core:servingFramework .

exprof:ModelIdentityRequirement a report:ReportingRequirement ;
    rdfs:label "Model identity and version requirement"@en ;
    report:requirementTargetsSection report:ModelSpecificationSection ;
    report:requiresInformationElement core:AIModelResource,
        core:hasDeveloper,
        core:hasModelCapability,
        core:hasModelInputSpecification,
        core:hasModelIntendedUse,
        core:hasModelLimitation,
        core:hasModelOutputSpecification,
        core:hasName,
        core:modelArchitectureType,
        core:modelIdentifier,
        core:modelReleaseDate,
        core:modelVersion,
        core:supportsInputModality,
        doc:hasLicense .

exprof:ModelRoleRequirement a report:ReportingRequirement ;
    rdfs:label "Model component role requirement"@en ;
    report:requirementTargetsSection report:ModelComponentsSection ;
    report:requiresInformationElement core:ModelComponent,
        core:hasModelComponentRole,
        core:usesModelResource .

exprof:ReportingCompletenessRubricReference a report:ReportingGuidelineReference ;
    core:hasName "AGENT-O paper reporting-completeness rubric" ;
    doc:sourceURI "https://w3id.org/agent-o/profiles/reporting-completeness"^^xsd:anyURI .
